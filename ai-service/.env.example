# Environment Configuration Template (Python FastAPI AI Service)
SERVICE_NAME=ai-service
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8001
API_V1_STR=/api/v1
INTERNAL_API_KEY=dev_secret_key_change_in_production

# LLM Provider Configuration
LLM_PROVIDER=heuristic
LLM_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-3.5-turbo
LLM_BASE_URL=https://api.openai.com/v1

# RAG & Vector Store Configuration
CHROMA_PERSIST_DIR=data/chroma_db
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=3
RAG_RELEVANCE_THRESHOLD=0.35

# Recommendation Engine Settings
MIN_TOPIC_ATTEMPTS=5
STRONG_ACCURACY_THRESHOLD=0.80
DEVELOPING_ACCURACY_THRESHOLD=0.50
RECENT_ACCURACY_WEIGHT=0.6
HISTORICAL_ACCURACY_WEIGHT=0.4
TREND_MARGIN=0.10
PRIORITY_WEAKNESS_WEIGHT=0.5
PRIORITY_TREND_WEIGHT=0.3
PRIORITY_RECENCY_WEIGHT=0.2
DEFAULT_PRACTICE_COUNT=5

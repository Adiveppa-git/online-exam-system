# Environment Configuration Template (PHP Web Application)
APP_ENV=development
APP_DEBUG=true

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=online_exam_system
DB_USER=root
DB_PASS=

# Outbound Mail & OTP Configuration
# Drivers: auto, brevo, smtp, mail, log
# In development (APP_ENV=development), missing provider keys automatically fallback to safe 'log' driver (logs/mail.log).
MAIL_DRIVER=auto
SENDER_EMAIL=noreply@example.com
SENDER_NAME="Online Examination System"

# Brevo REST API Driver (Optional)
BREVO_API_KEY=

# SMTP Socket Driver (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls

# AI Service Bridge Configuration
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TIMEOUT=35
AI_SERVICE_KEY=dev_secret_key_change_in_production

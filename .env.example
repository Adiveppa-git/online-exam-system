# Environment Configuration Template (PHP Web Application)
APP_ENV=development
APP_DEBUG=true

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=online_exam_system
DB_USER=root
DB_PASS=

# Outbound Mail & OTP Configuration
# Drivers: smtp (production Gmail/SMTP delivery), brevo, auto, mail, log
MAIL_DRIVER=smtp

# Gmail / Standard SMTP Driver Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=your-gmail@gmail.com
SMTP_PASSWORD=

SENDER_EMAIL=your-gmail@gmail.com
SENDER_NAME="Online Examination System"

# Brevo REST API Driver Configuration (Optional)
BREVO_API_KEY=

# AI Service Bridge Configuration
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TIMEOUT=35
AI_SERVICE_KEY=dev_secret_key_change_in_production
